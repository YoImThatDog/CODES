Algoritmo ejercicio4para
	
    Definir nunmeral,factorial Como Entero
    
    Escribir "Ingrese un número entero positivo:"
    Leer numeral
    
    factorial <- 1
    
    Para i <- 1 Hasta numeral Con Paso 1 Hacer
        factorial <- factorial * i
    FinPara
    
    Escribir "El factorial de ", numeral, " es: ", factorial

	
FinAlgoritmo
